{
  "name": "krishisaathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "kill": "taskkill /F /IM node.exe || true",
    "server:main": "node src/backend/server.js",
    "server:orders": "node src/backend/ordersServer.js",
    "server:users": "node src/backend/userserver.js",
    "server:payment": "node src/backend/payment.js",
    "backend": "concurrently --prefix-colors \"bgGreen.bold,bgBlue.bold,bgMagenta.bold,bgYellow.bold\" --names \"MAIN,ORDERS,USERS,PAYMENT\" \"npm run server:main\" \"npm run server:orders\" \"npm run server:users\" \"npm run server:payment\"",
    "start": "concurrently --prefix-colors \"bgCyan.bold,bgGreen.bold,bgBlue.bold,bgMagenta.bold,bgYellow.bold\" --names \"VITE,MAIN,ORDERS,USERS,PAYMENT\" \"npm run dev\" \"npm run server:main\" \"npm run server:orders\" \"npm run server:users\" \"npm run server:payment\"",
    "fresh": "npm run kill && npm run start",
    "start:safe": "npm run kill && concurrently --names \"VITE,MAIN,ORDERS,USERS,PAYMENT\" \"npm run dev\" \"npm run server:main\" \"npm run server:orders\" \"npm run server:users\" \"npm run server:payment\""
  },

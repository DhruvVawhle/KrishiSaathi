{
  "name": "krishisaathi-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "userserver.js",
  "scripts": {
    "start:users": "node userserver.js",
    "start:orders": "node ordersServer.js",
    "start:payment": "node payment.js",
    "dev:users": "nodemon userserver.js",
    "dev:orders": "nodemon ordersServer.js",
